---
layout: default
---
<div class="post academic-home">
  <div class="intro-grid">
    <header class="post-header">
      <h1 class="post-title">
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p class="desc">{{ page.subtitle }}</p>
    </header>
    <article class="intro-copy">
      {{ content | split: '<!-- research-background -->' | first }}
    </article>
    <aside class="portrait-column" aria-label="Photo and contact information">
      <img class="portrait" src="{{ '/assets/img/chonghe-jiang.jpg' | relative_url }}" alt="Chonghe Jiang" width="768" height="1024">
      <p class="portrait-credit">Photo: Hannah Y</p>
      <a class="portrait-email" href="mailto:chonghej@mit.edu">chonghej@mit.edu</a>
      <div class="profile-social">{% social_links %}</div>
    </aside>
  </div>
  <section class="home-news" id="news" aria-labelledby="news-heading">
    <div class="section-heading"><h2 id="news-heading">News</h2></div>
    {% for news_group in (1..2) %}
      {% if news_group == 1 %}
        {% assign news_items = site.data.news | slice: 0, 6 %}
      {% else %}
        {% assign news_items = site.data.news | slice: 6, 1000 %}
        {% if news_items.size > 0 %}
          <details class="news-archive">
            <summary>
              <span class="news-show">Show {{ news_items.size }} earlier updates</span><span class="news-hide">Hide earlier updates</span>
            </summary>
        {% endif %}
      {% endif %}
      {% if news_items.size > 0 %}
        <ul class="home-news-list">
          {% for item in news_items %}
            {% assign display_date = item.date %}
            {% if item.date.size == 7 %}{% assign display_date = item.date | append: '-01' %}{% endif %}
            <li>
              <time datetime="{{ item.date }}">{{ display_date | date: '%b %Y' }}</time>
              <div class="home-news-copy">{{ item.text | markdownify }}</div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if news_group == 2 and news_items.size > 0 %}</details>{% endif %}
    {% endfor %}
  </section>
  <section class="selected-work" id="research" aria-labelledby="research-heading">
    <div class="section-heading">
      <h2 id="research-heading">Research</h2>
      <a href="https://scholar.google.com/citations?user=KfuBD5kAAAAJ" target="_blank" rel="noopener"
        >Google Scholar <span aria-hidden="true">↗</span></a
      >
    </div>
    <aside class="research-story" aria-label="Research background">
      {{ content | split: '<!-- research-background -->' | last }}
    </aside>
    <p class="publication-note">* Equal contribution.</p>
    <div class="research-controls" hidden>
      <div class="research-filter-heading">
        <span>Explore by research direction</span>
        <button type="button" class="research-all" data-research-filter="all" aria-pressed="true">Show all</button>
      </div>
      <div class="research-directions" role="group" aria-label="Filter publications by research direction">
        {% for category in site.data.research_categories %}
          <button type="button" class="research-direction" data-research-filter="{{ category.id }}" aria-pressed="false">
            <span class="direction-title">{{ category.title }}</span>
            <span class="direction-subtitle">{{ category.subtitle }}</span>
          </button>
        {% endfor %}
      </div>
    </div>
    {% for category in site.data.research_categories %}
      <section class="paper-category" data-research-category="{{ category.id }}" aria-labelledby="selected-{{ category.id }}">
        <h3 class="paper-category-title" id="selected-{{ category.id }}">
          {{ category.title -}}
          {%- if category.id == 'self_improving' %}
            <span class="category-subtitle">(Self-Improving Agents)</span>
          {%- endif %}
        </h3>
        {% for group in category.groups %}
          <section
            class="paper-group"
            data-paper-group="{{ group.id }}"
            {% if group.title %}
              aria-labelledby="group-{{ group.id }}"
            {% endif %}
          >
            {% if group.title %}
              <h4 class="paper-group-title" id="group-{{ group.id }}">{{ group.title }}</h4>
            {% endif %}
            <div class="paper-list">
              {% assign group_papers = site.data.publications | where: 'group', group.id %}
              {% for paper in group_papers %}
                <article
                  class="paper-row{% unless paper.figure %} paper-row-text{% endunless %}"
                  id="featured-{{ paper.key }}"
                  {% if paper.working %}
                    data-working-paper
                  {% endif %}
                >
                  {% if paper.figure %}
                    <button
                      class="paper-figure"
                      type="button"
                      data-figure-title="{{ paper.figure_alt | escape }}"
                      aria-label="Enlarge figure for {{ paper.short_title | escape }}"
                    >
                      <span class="figure-viewport"
                        ><img src="{{ paper.figure | relative_url | bust_file_cache }}" alt="{{ paper.figure_alt | escape }}" loading="lazy"
                      ></span>
                      <span class="figure-footer" aria-hidden="true"
                        ><span class="figure-name">{{ paper.short_title }}</span><span class="figure-hint">↗</span></span
                      >
                    </button>
                  {% endif %}
                  <div class="paper-text">
                    {% if paper.focus %}
                      <p class="paper-focus">{{ paper.focus }}</p>
                    {% endif %}
                    <h5>
                      {% if paper.url -%}
                        <a href="{{ paper.url }}" target="_blank" rel="noopener">{{ paper.title }}</a>
                      {%- else -%}
                        {{- paper.title -}}
                      {%- endif %}
                    </h5>
                    <div class="paper-authors">
                      {% if paper.collaborators %}
                        With {{ paper.collaborators | join: ', ' }}.
                      {% endif %}
                      {% for author in paper.authors limit: 6 %}
                        {% if author contains 'Chonghe Jiang' -%}
                          <strong>{{ author }}</strong>
                        {%- else -%}
                          {{- author -}}
                        {%- endif -%}
                        {%- unless forloop.last %}, {% endunless %}
                      {% endfor %}
                      {% if paper.authors.size > 6 %}
                        <details class="remaining-authors">
                          <summary>and {{ paper.authors.size | minus: 6 }} more authors</summary>
                          <span>
                            {%- for author in paper.authors offset: 6 -%}
                              {% if author contains 'Chonghe Jiang' -%}
                                <strong>{{ author }}</strong>
                              {%- else %}
                                {{- author -}}
                              {% endif %}
                              {%- unless forloop.last %}, {% endunless -%}
                            {%- endfor -%}
                          </span>
                        </details>
                      {% endif %}
                    </div>
                    <p class="paper-venue">{{ paper.venue }}</p>
                    {% if paper.award %}
                      <p class="paper-award">{{ paper.award }}</p>
                    {% endif %}
                    {% if paper.description %}
                      <p class="paper-description">{{ paper.description }}</p>
                    {% endif %}
                    {% if paper.url or paper.code %}
                      <div class="paper-links">
                        {% if paper.url -%}
                          <a href="{{ paper.url }}" target="_blank" rel="noopener">paper</a>
                        {%- endif %}
                        {% if paper.code -%}
                          <a href="{{ paper.code }}" target="_blank" rel="noopener">code</a>
                        {%- endif %}
                      </div>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          </section>
        {% endfor %}
      </section>
    {% endfor %}
  </section>
</div>
<dialog class="figure-dialog" aria-label="Publication figure">
  <button type="button" class="figure-close" aria-label="Close figure">×</button>
  <img alt="">
  <p class="figure-caption"></p>
</dialog>
